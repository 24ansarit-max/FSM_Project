module parameterized_mac #(
    parameter int DATA_WIDTH = 8,
    parameter int GUARD_BITS = $clog2(DATA_WIDTH),
    parameter int ACC_WIDTH  = (2 * DATA_WIDTH) + GUARD_BITS
)(
    input  logic                  clk,
    input  logic                  rst,

    input  logic                  start,
    input  logic                  clear_acc,

    input  logic [DATA_WIDTH-1:0] A,
    input  logic [DATA_WIDTH-1:0] B,

    input  logic                  signed_mode,
    input  logic                  valid_in,
    input  logic                  last,

    output logic [ACC_WIDTH-1:0]  acc_out,
    output logic                  valid_out,
    output logic                  done,
    output logic                  busy,
    output logic                  overflow,
    output logic                  saturated
);

    //============================================================
    // Parameter checks
    //============================================================
    initial begin
        if ((DATA_WIDTH != 8) && (DATA_WIDTH != 16))
            $error("DATA_WIDTH must be 8 or 16");

        if (ACC_WIDTH < (2 * DATA_WIDTH))
            $error("ACC_WIDTH must be >= 2*DATA_WIDTH");
    end

    // DSP48E1-friendly operand width.
    // DATA_WIDTH=8  -> 9 x 9
    // DATA_WIDTH=16 -> 17 x 17
    localparam int DSP_OP_WIDTH  = DATA_WIDTH + 1;
    localparam int DSP_PROD_WIDTH = 2 * DSP_OP_WIDTH;

    //============================================================
    // FSM
    //============================================================
    typedef enum logic [5:0] {
        IDLE       = 6'b000001,
        LOAD       = 6'b000010,
        MULTIPLY   = 6'b000100,
        ACCUMULATE = 6'b001000,
        SATURATE   = 6'b010000,
        DONE       = 6'b100000
    } state_t;

    state_t state;
    state_t next_state;

    //============================================================
    // Input registers
    //============================================================
    logic signed [DSP_OP_WIDTH-1:0] A_reg;
    logic signed [DSP_OP_WIDTH-1:0] B_reg;

    logic signed_mode_reg;
    logic last_reg;

    //============================================================
    // Registered product
    //============================================================
    (* use_dsp = "yes" *)
    logic signed [DSP_PROD_WIDTH-1:0] product_reg;

    //============================================================
    // Accumulator
    //============================================================
    logic signed [ACC_WIDTH-1:0] accumulator;

    //============================================================
    // MAC result
    //============================================================
    (* use_dsp = "yes" *)
    logic signed [ACC_WIDTH:0] mac_sum_reg;

    //============================================================
    // Extended product
    //============================================================
    logic signed [ACC_WIDTH:0] product_ext;

    //============================================================
    // Saturation constants
    //============================================================
    localparam logic signed [ACC_WIDTH-1:0] SIGNED_MAX =
        {1'b0, {(ACC_WIDTH-1){1'b1}}};

    localparam logic signed [ACC_WIDTH-1:0] SIGNED_MIN =
        {1'b1, {(ACC_WIDTH-1){1'b0}}};

    localparam logic [ACC_WIDTH-1:0] UNSIGNED_MAX =
        {ACC_WIDTH{1'b1}};

    //============================================================
    // State register
    //============================================================
    always_ff @(posedge clk) begin
        if (rst)
            state <= IDLE;
        else
            state <= next_state;
    end

    //============================================================
    // Next-state logic
    //============================================================
    always_comb begin

        next_state = state;

        case (state)

            IDLE: begin
                if (start)
                    next_state = LOAD;
            end

            LOAD: begin
                if (valid_in)
                    next_state = MULTIPLY;
            end

            MULTIPLY: begin
                next_state = ACCUMULATE;
            end

            ACCUMULATE: begin
                next_state = SATURATE;
            end

            SATURATE: begin
                if (last_reg)
                    next_state = DONE;
                else
                    next_state = LOAD;
            end

            DONE: begin
                if (start)
                    next_state = LOAD;
                else
                    next_state = IDLE;
            end

            default: begin
                next_state = IDLE;
            end

        endcase

    end

    //============================================================
    // Product extension
    //============================================================
    always_comb begin

        product_ext = '0;

        product_ext =
            $signed(product_reg);

    end

    //============================================================
    // Busy output
    //============================================================
    always_comb begin

        busy = 1'b1;

        case (state)

            IDLE: begin
                busy = 1'b0;
            end

            DONE: begin
                busy = 1'b0;
            end

            default: begin
                busy = 1'b1;
            end

        endcase

    end

    //============================================================
    // Main datapath and registered outputs
    //============================================================
    always_ff @(posedge clk) begin

        if (rst) begin

            A_reg           <= '0;
            B_reg           <= '0;
            signed_mode_reg <= 1'b0;
            last_reg        <= 1'b0;

            product_reg     <= '0;
            accumulator     <= '0;
            mac_sum_reg     <= '0;

            acc_out         <= '0;

            valid_out       <= 1'b0;
            done            <= 1'b0;
            overflow        <= 1'b0;
            saturated       <= 1'b0;

        end
        else begin

            // Registered one-cycle handshake pulses.
            valid_out <= 1'b0;
            done      <= 1'b0;

            //====================================================
            // Clear accumulator
            //====================================================
            if (clear_acc) begin

                accumulator <= '0;
                mac_sum_reg <= '0;

                overflow    <= 1'b0;
                saturated   <= 1'b0;

                // Discard any partially processed item.
                if ((state != IDLE) && (state != DONE))
                    state <= LOAD;

            end
            else begin

                case (state)

                    //================================================
                    // IDLE
                    //================================================
                    IDLE: begin

                        if (start) begin

                            accumulator <= '0;

                            overflow  <= 1'b0;
                            saturated <= 1'b0;

                            // Mode is fixed for the entire sequence.
                            signed_mode_reg <= signed_mode;

                        end

                    end

                    //================================================
                    // LOAD
                    //================================================
                    LOAD: begin

                        if (valid_in) begin

                            // Convert both modes into one signed
                            // DSP operand representation.
                            //
                            // Signed:
                            //   sign extension is performed.
                            //
                            // Unsigned:
                            //   MSB is forced to zero, making the
                            //   signed DSP multiplication positive.

                            if (signed_mode_reg) begin

                                A_reg <=
                                    $signed({
                                        A[DATA_WIDTH-1],
                                        A
                                    });

                                B_reg <=
                                    $signed({
                                        B[DATA_WIDTH-1],
                                        B
                                    });

                            end
                            else begin

                                A_reg <=
                                    $signed({
                                        1'b0,
                                        A
                                    });

                                B_reg <=
                                    $signed({
                                        1'b0,
                                        B
                                    });

                            end

                            last_reg <= last;

                        end

                    end

                    //================================================
                    // MULTIPLY
                    //================================================
                    MULTIPLY: begin

                        // Registered multiplication.
                        //
                        // Vivado can map this operation to the
                        // DSP48E1 multiplier.

                        product_reg <= A_reg * B_reg;

                    end

                    //================================================
                    // ACCUMULATE
                    //================================================
                    ACCUMULATE: begin

                        // Single shared accumulation datapath.
                        //
                        // Both signed and unsigned products have
                        // already been represented in a common
                        // two's-complement format.

                        mac_sum_reg <=
                            $signed({
                                accumulator[ACC_WIDTH-1],
                                accumulator
                            }) +
                            product_ext;

                    end

                    //================================================
                    // SATURATE / OVERFLOW CHECK
                    //================================================
                    SATURATE: begin

                        if (signed_mode_reg) begin

                            // Positive signed overflow:
                            // 01... -> 10... transition.
                            if ((mac_sum_reg[ACC_WIDTH] == 1'b0) &&
                                (mac_sum_reg[ACC_WIDTH-1] == 1'b1)) begin

                                accumulator <= SIGNED_MAX;

                                overflow  <= 1'b1;
                                saturated <= 1'b1;

                            end

                            // Negative signed overflow:
                            // 10... transition.
                            else if ((mac_sum_reg[ACC_WIDTH] == 1'b1) &&
                                     (mac_sum_reg[ACC_WIDTH-1] == 1'b0)) begin

                                accumulator <= SIGNED_MIN;

                                overflow  <= 1'b1;
                                saturated <= 1'b1;

                            end

                            else begin

                                accumulator <=
                                    mac_sum_reg[ACC_WIDTH-1:0];

                            end

                        end
                        else begin

                            // In unsigned mode all operands are
                            // represented as non-negative values.
                            //
                            // Therefore bit ACC_WIDTH indicates
                            // unsigned carry-out.

                            if (mac_sum_reg[ACC_WIDTH]) begin

                                accumulator <=
                                    $signed(UNSIGNED_MAX);

                                overflow  <= 1'b1;
                                saturated <= 1'b1;

                            end

                            else begin

                                accumulator <=
                                    mac_sum_reg[ACC_WIDTH-1:0];

                            end

                        end

                    end

                    //================================================
                    // DONE
                    //================================================
                    DONE: begin

                        acc_out   <= accumulator;
                        valid_out <= 1'b1;
                        done      <= 1'b1;

                        // Back-to-back sequence support.
                        if (start) begin

                            accumulator <= '0;

                            overflow  <= 1'b0;
                            saturated <= 1'b0;

                            signed_mode_reg <= signed_mode;

                        end

                    end

                    //================================================
                    // Safety recovery
                    //================================================
                    default: begin

                        state <= IDLE;

                        accumulator <= '0;
                        overflow    <= 1'b0;
                        saturated   <= 1'b0;

                    end

                endcase

            end

        end

    end

endmodule
